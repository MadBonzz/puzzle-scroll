{
  "name": "puzzle-scroll",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:phone": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "test:unit": "jest --runInBand --config jest.config.cjs tests/unit tests/content",
    "test:integration": "jest --runInBand --config jest.config.cjs tests/integration",
    "test:content": "jest --runInBand --config jest.config.cjs tests/content",
    "test:e2e": "npm run build && playwright test",
    "validate:puzzles": "node scripts/validate-hard-puzzles.mjs",
    "report:content": "node scripts/generate-content-evidence.cjs",
    "report:ledger": "node scripts/generate-verification-ledger.cjs",
    "test:mutations": "node scripts/run-negative-controls.cjs",
    "typecheck": "tsc --noEmit",
    "serve:e2e": "node scripts/serve-dist.mjs",
    "verify": "npm run report:content && npm run typecheck && npm run test:unit && npm run test:integration && npm run validate:puzzles && npm run test:mutations && npm run test:e2e && npm run report:ledger"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "55.0.23",
    "expo-haptics": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "19.2.14",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "typescript": "5.9.3"
  }
}
